# ─── Student Hub Environment Configuration ────────────────────────────────────
# IMPORTANT: Replace this with a cryptographically random 32+ char secret
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-key-in-production-min-32-chars

# Node environment
NODE_ENV=development

# App URL (change for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
